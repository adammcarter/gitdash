VERSION = "dev"  # stamped with the tag by the release workflow

POLL_SECONDS = 0.7
MAX_POLL_SECONDS = 10.0
HEARTBEAT_SECONDS = 15
REF_RECHECK_SECONDS = 10.0
DIFF_CAP_BYTES = 3 * 1024 * 1024
MAX_FILES = 5000
GIT_TIMEOUT = 60
BINARY_SNIFF_BYTES = 8000                # what git looks at to call a file binary
BIG_FILE_DEFAULT = 512 * 1024 * 1024     # git's default core.bigFileThreshold

GIT_ENV = dict(
    os.environ,
    GIT_OPTIONAL_LOCKS="0",
    GIT_LITERAL_PATHSPECS="1",
    GIT_TERMINAL_PROMPT="0",
    GIT_PAGER="cat",
    PAGER="cat",
)
GIT_BASE = [
    "git", "--no-pager",
    "-c", "core.quotepath=off",
    "-c", "color.ui=never",
    "-c", "diff.noprefix=false",
    "-c", "diff.mnemonicPrefix=false",
    "-c", "diff.relative=false",
]


class GitError(Exception):
    pass


def git(args, cwd, ok=(0,), timeout=GIT_TIMEOUT, env=None, input=None):
    io = {"input": input} if input is not None else {"stdin": subprocess.DEVNULL}
    try:
        proc = subprocess.run(
            GIT_BASE + args, cwd=cwd, env=env or GIT_ENV,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout, **io
        )
    except subprocess.TimeoutExpired:
        raise GitError("git %s timed out" % args[0])
    if proc.returncode not in ok:
        raise GitError(proc.stderr.decode("utf-8", "replace").strip() or "git %s failed" % args[0])
    return proc.stdout, proc.returncode


def resolve_git_binary():
    """/usr/bin/git on macOS is an xcrun shim that costs several ms per call.
    Find the real binary once so the watch loop does not pay that every tick."""
    try:
        out, _ = git(["--exec-path"], os.getcwd(), timeout=10)
        cand = os.path.realpath(os.path.join(os.fsdecode(out).strip(), "git"))
        if not (os.path.isfile(cand) and os.access(cand, os.X_OK)):
            return
        proc = subprocess.run([cand, "--version"], stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
        if proc.returncode == 0 and proc.stdout.startswith(b"git version"):
            GIT_BASE[0] = cand
    except (OSError, GitError, subprocess.SubprocessError):
        pass


def split_z(data):
    return [os.fsdecode(t) for t in data.split(b"\0")]


Change = collections.namedtuple("Change", "code score path old smode dmode ssha dsha")


def parse_raw(data):
    """Parse `git diff --raw -z --no-abbrev` output."""
    toks = split_z(data)
    out, i = [], 0
    while i < len(toks):
        meta = toks[i]
        fields = meta[1:].split(" ") if meta.startswith(":") else []
        if len(fields) < 5:
            i += 1
            continue
        smode, dmode, ssha, dsha, st = fields[:5]
        code, score = st[0], st[1:]
        score = int(score) if score.isdigit() else None
        if code in "RC":
            if i + 2 >= len(toks):
                break
            out.append(Change(code, score, toks[i + 2], toks[i + 1], smode, dmode, ssha, dsha))
            i += 3
        else:
            if i + 1 >= len(toks):
                break
            out.append(Change(code, score, toks[i + 1], None, smode, dmode, ssha, dsha))
            i += 2
    return out


def parse_numstat(data):
    toks = split_z(data)
    out, i = {}, 0
    while i < len(toks):
        t = toks[i]
        if not t:
            i += 1
            continue
        parts = t.split("\t", 2)
        if len(parts) < 3:
            i += 1
            continue
        a, d, p = parts
        if p == "":
            p = toks[i + 2] if i + 2 < len(toks) else ""
            i += 3
        else:
            i += 1
        if a == "-" or d == "-":
            out[p] = (0, 0, True)
        else:
            out[p] = (int(a), int(d), False)
    return out


def parse_size(text, default):
    t = text.strip().lower()
    mult = {"k": 1 << 10, "m": 1 << 20, "g": 1 << 30}.get(t[-1:], 1)
    if t[-1:] in "kmg":
        t = t[:-1]
    try:
        return int(t) * mult
    except ValueError:
        return default


def stat_key(st):
    return (st.st_mtime_ns, st.st_size, st.st_mode, st.st_ctime_ns) if st else None


def file_key(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    return (st.st_mtime_ns, st.st_size, st.st_ino, st.st_ctime_ns)


class Repo:
    """Watches one work tree.

    `git diff HEAD` refreshes stat info in the index and writes it back even
    with GIT_OPTIONAL_LOCKS=0, so every git command here runs against a
    private copy of the index (GIT_INDEX_FILE), re-copied whenever the real
    index changes. The real index is only ever read, never written or locked.
    """

    def __init__(self, root, tmpdir):
        self.root = root
        out, _ = git(["rev-parse", "--path-format=absolute",
                      "--git-path", "index", "--git-path", "HEAD",
                      "--git-path", "info/attributes", "--git-common-dir"], root)
        lines = os.fsdecode(out).splitlines()
        self.index_src, self.head_file, self.info_attrs, self.common_dir = lines[:4]
        out, _ = git(["hash-object", "-t", "tree", "/dev/null"], root)
        self.empty_tree = out.decode().strip()
        self.blob_hash = hashlib.sha256 if len(self.empty_tree) == 64 else hashlib.sha1
        out, rc = git(["config", "--get", "core.bigFileThreshold"], root, ok=(0, 1))
        self.big_file = parse_size(out.decode("utf-8", "replace"), BIG_FILE_DEFAULT) if rc == 0 else BIG_FILE_DEFAULT
        self.tmpdir = tmpdir
        self.index_copy = os.path.join(tmpdir, "index")
        self.index_key = None
        self.env = dict(GIT_ENV, GIT_INDEX_FILE=self.index_copy)
        self.index_lock = threading.Lock()  # serialises git runs that may rewrite the copy
        self.name = os.path.basename(root.rstrip("/")) or root
        self.sig = None
        self.ref_key, self.ref_checked, self.ref_val = None, 0.0, (None, None)
        self.cached_key, self.cached_raw, self.cached_num = None, b"", None
        self.line_cache = {}
        self.attr_gen = None
        self.hash_cache = {}
        self.blob_sizes = {}
        self.seen_gone = {}
        self.last_change = None
        self.prev_state = None   # (head, branch, stash count, paths) at the last published snapshot
        self.events = []         # newest first: commits, stashes, branch switches...
        self.event_seq = 0
        self.cond = threading.Condition()
        self.version = 0
        self.payload = b""
        self.meta = {}          # path -> (mode, from); swapped whole, never mutated
        self.base = self.empty_tree  # tree-ish the diff endpoint compares against
        self.stopping = False
        self._last_error = None

    def _git(self, args, ok=(0,), input=None):
        return git(args, self.root, ok=ok, env=self.env, input=input)

    def _sync_index(self):
        try:
            st = os.stat(self.index_src)
        except FileNotFoundError:
            st = None
        key = (st.st_mtime_ns, st.st_size, st.st_ino, st.st_ctime_ns) if st else None
        if key == self.index_key:
            return
        if st is None:
            try:
                os.remove(self.index_copy)
            except FileNotFoundError:
                pass
        else:
            tmp = self.index_copy + ".new"
            shutil.copy2(self.index_src, tmp)
            os.replace(tmp, self.index_copy)
        self.index_key = key

    # ---- HEAD and branch, re-read from git only when the ref files move ----

    def _refs_key(self):
        try:
            with open(self.head_file, "rb") as fh:
                head_txt = fh.read(4096)
        except OSError:
            head_txt = b""
        paths = [os.path.join(self.common_dir, "packed-refs"),
                 os.path.join(self.common_dir, "reftable", "tables.list")]
        if head_txt.startswith(b"ref: "):
            ref = os.fsdecode(head_txt[5:].strip())
            paths.append(os.path.join(self.common_dir, ref))
            paths.append(os.path.join(os.path.dirname(self.head_file), ref))
        return (head_txt,) + tuple(file_key(p) for p in paths)

    def _refs(self):
        key = self._refs_key()
        now = time.monotonic()
        if key == self.ref_key and now - self.ref_checked < REF_RECHECK_SECONDS:
            return self.ref_val
        out, rc = self._git(["rev-parse", "-q", "--verify", "HEAD^{commit}"], ok=(0, 1, 128))
        head = out.decode().strip() if rc == 0 and out.strip() else None
        out, rc = self._git(["symbolic-ref", "-q", "--short", "HEAD"], ok=(0, 1, 128))
        branch = out.decode("utf-8", "replace").strip() if rc == 0 else None
        self.ref_key, self.ref_checked, self.ref_val = key, now, (head, branch)
        return head, branch

    # ---- events: what took changes away (commit, stash, checkout...) ----

    def _stash_count(self):
        try:
            with open(os.path.join(self.common_dir, "logs", "refs", "stash"), "rb") as fh:
                return sum(1 for line in fh if line.strip())
        except OSError:
            return 0

    def _event(self, prev, head, branch, stash, paths):
        p_head, p_branch, p_stash, p_paths = prev
        left = len(p_paths - paths)
        came = len(paths - p_paths)
        ev = None
        if stash > p_stash:
            out, _ = self._git(["log", "-g", "-1", "--format=%gs", "refs/stash", "--"], ok=(0, 128))
            msg = out.decode("utf-8", "replace").strip()
            msg = msg.split(": ", 1)[1] if ": " in msg else msg
            ev = {"title": "Stashed", "detail": msg, "files": left}
        elif stash < p_stash and head == p_head:
            ev = {"title": "Stash popped" if came else "Stash dropped", "files": came}
        elif head != p_head and head:
            out, _ = self._git(["log", "-g", "-1", "--format=%gs", "HEAD", "--"], ok=(0, 128))
            action = out.decode("utf-8", "replace").strip()
            verb, _, rest = action.partition(": ")
            out, _ = self._git(["log", "-1", "--format=%h%x00%s", head, "--"], ok=(0, 128))
            sha, _, subject = out.decode("utf-8", "replace").strip().partition("\0")
            v = verb.split(" ")[0]
            if v == "commit":
                title = "Amended" if "amend" in verb else "Committed"
                ev = {"title": title, "sha": sha, "detail": subject, "files": left}
            elif v == "checkout" or v == "switch":
                ev = {"title": "Switched to %s" % (branch or sha), "files": left}
            elif v == "reset":
                ev = {"title": "Reset to %s" % sha, "detail": subject, "files": left}
            else:
                names = {"pull": "Pulled", "merge": "Merged", "rebase": "Rebased", "cherry-pick": "Cherry-picked",
                         "revert": "Reverted", "am": "Applied patch"}
                ev = {"title": names.get(v, "HEAD moved to %s" % sha), "sha": sha if v in names else None,
                      "detail": subject, "files": left}
        elif branch != p_branch:
            ev = {"title": "Switched to %s" % (branch or "detached HEAD"), "files": left}
        if not ev:
            return
        self.event_seq += 1
        ev["id"] = self.event_seq
        ev["time"] = time.time()
        self.events = ([{k: v for k, v in ev.items() if v not in (None, "")}] + self.events)[:20]

    # ---- untracked files: line counts that agree with git ----

    def _attr_binary(self, paths):
        """path -> True (diff unset: binary), False (diff set: text), None (git decides)."""
        if not paths:
            return {}
        data = b"".join(os.fsencode(p) + b"\0" for p in paths)
        out, _ = self._git(["check-attr", "-z", "--stdin", "diff"], input=data)
        toks = split_z(out)
        res = {}
        for i in range(0, len(toks) - 2, 3):
            val = toks[i + 2]
            res[toks[i]] = True if val == "unset" else False if val == "set" else None
        return res

    def _count_lines(self, path, st, binattr):
        add, binary = 0, False
        if stat.S_ISLNK(st.st_mode):
            add = 1
        elif not stat.S_ISREG(st.st_mode) or binattr is True:
            binary = True
        elif binattr is None and st.st_size > self.big_file:
            binary = True
        else:
            try:
                with open(os.path.join(self.root, path), "rb") as fh:
                    head = fh.read(BINARY_SNIFF_BYTES)
                    if binattr is None and b"\0" in head:
                        binary = True
                    else:
                        add, last = head.count(b"\n"), head[-1:]
                        while True:
                            chunk = fh.read(1 << 20)
                            if not chunk:
                                break
                            add += chunk.count(b"\n")
                            last = chunk[-1:]
                        if last and last != b"\n":
                            add += 1
            except OSError:
                add = 0
        return add, binary

    def _untracked_counts(self, paths, stats):
        need = [p for p in paths
                if stats.get(p) and (self.line_cache.get(p) or (None,))[0] != stat_key(stats[p])]
        attrs = self._attr_binary([p for p in need if stat.S_ISREG(stats[p].st_mode)])
        for p in need:
            st = stats[p]
            add, binary = self._count_lines(p, st, attrs.get(p))
            self.line_cache[p] = (stat_key(st), add, binary)

    def _attrs_generation(self, paths, stats):
        parts = [file_key(self.info_attrs)]
        for p in paths:
            if p == ".gitattributes" or p.endswith("/.gitattributes"):
                parts.append((p, stat_key(stats.get(p))))
        return tuple(parts)

    # ---- plain `mv` of a tracked file: pair exact copies as renames ----

    def _blob_id(self, path, st):
        key = stat_key(st)
        hit = self.hash_cache.get(path)
        if hit and hit[0] == key:
            return hit[1]
        h = self.blob_hash(b"blob %d\0" % st.st_size)
        try:
            with open(os.path.join(self.root, path), "rb") as fh:
                while True:
                    chunk = fh.read(1 << 20)
                    if not chunk:
                        break
                    h.update(chunk)
            val = h.hexdigest()
        except OSError:
            val = None
        self.hash_cache[path] = (key, val)
        return val

    def _pair_moves(self, deleted, untracked, stats):
        """deleted: {path: Change}; returns {new_path: old_path} for unique exact matches."""
        by_sha = collections.defaultdict(list)
        for p, c in deleted.items():
            by_sha[c.ssha].append(p)
        missing = [s for s in by_sha if s not in self.blob_sizes]
        if missing:
            out, _ = self._git(["cat-file", "--batch-check=%(objectname) %(objectsize)"],
                               input="".join(s + "\n" for s in missing).encode(), ok=(0, 128))
            for line in out.decode("utf-8", "replace").splitlines():
                parts = line.split()
                if len(parts) == 2 and parts[1].isdigit():
                    self.blob_sizes[parts[0]] = int(parts[1])
            for s in missing:
                self.blob_sizes.setdefault(s, -1)
        sizes = {self.blob_sizes.get(s) for s in by_sha} - {-1, 0, None}
        found = collections.defaultdict(list)
        for p in untracked:
            st = stats.get(p)
            if st is None or not stat.S_ISREG(st.st_mode) or st.st_size not in sizes:
                continue
            bid = self._blob_id(p, st)
            if bid in by_sha:
                found[bid].append(p)
        pairs = {}
        for sha, news in found.items():
            olds = by_sha[sha]
            if len(news) != 1 or len(olds) != 1:
                continue
            old, new = olds[0], news[0]
            old_exec = deleted[old].smode == "100755"
            if old_exec != bool(stats[new].st_mode & 0o100) or deleted[old].smode not in ("100644", "100755"):
                continue
            pairs[new] = old
        return pairs

    # ---- the snapshot ----

    def scan(self):
        """Check git; publish a new snapshot only when the signature changed."""
        with self.index_lock:
            return self._scan()

    def _seen(self, path, now, store):
        t = self.seen_gone.get(path, now)
        store[path] = t
        return t

    def _scan(self):
        self._sync_index()
        head, branch = self._refs()
        base = head or self.empty_tree
        wt_raw, _ = self._git(["diff", base, "-M", "--raw", "-z", "--no-abbrev", "--no-ext-diff"])
        un_raw, _ = self._git(["ls-files", "--others", "--exclude-standard", "-z"])
        ckey = (self.index_key, head)
        if ckey != self.cached_key:
            # index vs HEAD only changes when the index or HEAD does
            self.cached_raw, _ = self._git(["diff", "--cached", base, "-M", "--raw", "-z", "--no-abbrev", "--no-ext-diff"])
            self.cached_key, self.cached_num = ckey, None
        wt = parse_raw(wt_raw)
        untracked = [p for p in split_z(un_raw) if p]
        untracked_set = set(untracked)
        wt_paths = {c.path for c in wt} | {c.old for c in wt if c.old}
        staged_only = [c for c in parse_raw(self.cached_raw)
                       if c.path not in wt_paths and c.old not in wt_paths and c.path not in untracked_set]

        stats = {}
        h = hashlib.sha1()
        stash = self._stash_count()
        h.update(("%s|%s|%d|" % (head, branch, stash)).encode())
        for blob in (wt_raw, un_raw, self.cached_raw):
            h.update(blob)
            h.update(b"\1")
        for p in [c.path for c in wt] + [c.path for c in staged_only] + untracked:
            try:
                st = os.lstat(os.path.join(self.root, p.rstrip("/")))
            except OSError:
                st = None
            stats[p] = st
            h.update(b"%d:%d:%d:%d;" % (stat_key(st) or (0, 0, 0, 0)))
        sig = h.digest()
        if sig == self.sig:
            return False

        num_raw, _ = self._git(["diff", base, "-M", "--numstat", "-z", "--no-ext-diff"])
        numstat = parse_numstat(num_raw)
        if staged_only and self.cached_num is None:
            out, _ = self._git(["diff", "--cached", base, "-M", "--numstat", "-z", "--no-ext-diff"])
            self.cached_num = parse_numstat(out)
        cached_num = self.cached_num or {}

        gen = self._attrs_generation(list(stats), stats)
        if gen != self.attr_gen:
            self.line_cache, self.attr_gen = {}, gen
        live = set(untracked)
        self.line_cache = {k: v for k, v in self.line_cache.items() if k in live}
        self.hash_cache = {k: v for k, v in self.hash_cache.items() if k in live}

        now = time.time()
        entries, meta, seen_now = [], {}, {}
        removed_but_on_disk = {c.path for c in wt if c.code == "D" and c.path in untracked_set}
        plain_deleted = {c.path: c for c in wt if c.code == "D" and c.path not in untracked_set}
        candidates = [p for p in untracked if p not in removed_but_on_disk and not p.endswith("/")]
        pairs = self._pair_moves(plain_deleted, candidates, stats) if plain_deleted and candidates else {}
        paired_old = set(pairs.values())

        for c in wt:
            path, frm = c.path, (c.old if c.code == "R" else None)
            hint, mode = None, "wt"
            if c.code == "D":
                if path in paired_old:
                    continue
                kind = "deleted"
                if path in removed_but_on_disk:
                    hint, mode = "Removed from git, still on disk", "cached"
                mtime, sk = self._seen(path, now, seen_now), None
            else:
                kind = "added" if c.code in "AC" else "modified"
                st = stats.get(path)
                mtime, sk = (st.st_mtime if st else now), stat_key(st)
            add, dele, binary = numstat.get(path, (0, 0, False))
            pure = c.code == "R" and c.score == 100 and c.smode == c.dmode
            # HEAD-side blob and modes stand in for HEAD: a commit that leaves this file alone keeps its ver
            ident = (c.ssha, c.smode, c.dmode)
            entries.append(self._entry(path, frm, kind, add, dele, binary, mtime, sk, ident, None, hint, pure))
            meta[path] = (mode, frm)

        for c in staged_only:
            path, frm = c.path, (c.old if c.code == "R" else None)
            st = stats.get(path)
            kind = "added" if c.code in "AC" else "deleted" if c.code == "D" else "modified"
            if st is None:
                hint = "Staged, then deleted from disk" if kind != "deleted" else None
                mtime = self._seen(path, now, seen_now)
            else:
                hint, mtime = "Staged; working tree matches HEAD", st.st_mtime
            add, dele, binary = cached_num.get(path, (0, 0, False))
            pure = c.code == "R" and c.score == 100 and c.smode == c.dmode
            ident = (c.ssha, c.dsha, c.smode, c.dmode)
            entries.append(self._entry(path, frm, kind, add, dele, binary, mtime, stat_key(st), ident, None, hint, pure))
            meta[path] = ("cached", frm)

        self._untracked_counts([p for p in candidates if p not in pairs], stats)
        for path in untracked:
            if path in removed_but_on_disk:
                continue
            st = stats.get(path)
            if path in pairs:
                old = pairs[path]
                ident = (plain_deleted[old].ssha, plain_deleted[old].smode)
                entries.append(self._entry(path, old, "modified", 0, 0, False, st.st_mtime, stat_key(st), ident, None, None, True))
                meta[path] = ("pair", old)
                continue
            note = None
            if path.endswith("/"):
                add, binary, note = 0, False, "Nested repository"
            elif st is None:
                continue
            else:
                hit = self.line_cache.get(path)
                add, binary = (hit[1], hit[2]) if hit else (0, False)
            mtime = st.st_mtime if st else now
            entries.append(self._entry(path, None, "added", add, 0, binary, mtime, stat_key(st), None, note, None, False))
            meta[path] = ("note" if note else "untracked", None)

        self.seen_gone = seen_now

        totals = {
            "files": len(entries),
            "add": sum(e["add"] for e in entries),
            "del": sum(e["del"] for e in entries),
        }
        truncated = len(entries) > MAX_FILES
        if truncated:
            entries.sort(key=lambda e: -e["mtime"])
            entries = entries[:MAX_FILES]
            keep = {e["path"] for e in entries}
            meta = {k: v for k, v in meta.items() if k in keep}

        if self.sig is None:
            # deleted files carry "first seen" times, which at startup is just now
            self.last_change = max((e["mtime"] for e in entries if e["kind"] != "deleted"), default=None)
        else:
            self.last_change = now
        self.sig = sig

        paths = {e["path"] for e in entries}
        if self.prev_state is not None:
            self._event(self.prev_state, head, branch, stash, paths)
        self.prev_state = (head, branch, stash, paths)

        if branch:
            branch_label, detached = branch, False
        else:
            branch_label, detached = "detached at %s" % (head or "")[:7], True

        snap = {
            "repo": self.name,
            "branch": branch_label,
            "detached": detached,
            "nocommits": head is None,
            "files": entries,
            "totals": totals,
            "truncated": truncated,
            "last_change": self.last_change,
            "events": self.events[:10],
            "now": now,
        }
        payload = json.dumps(snap, separators=(",", ":")).encode()
        with self.cond:
            self.meta = meta
            self.base = base
            self.payload = payload
            self.version += 1
            self.cond.notify_all()
        return True

    @staticmethod
    def _entry(path, frm, kind, add, dele, binary, mtime, sk, ident, note, hint, pure):
        raw = "%s|%s|%s|%d|%d|%d|%r|%r|%r|%s|%s|%d" % (
            path, kind, frm, add, dele, binary, mtime, sk, ident, note, hint, pure)
        e = {
            "path": path, "from": frm, "kind": kind, "add": add, "del": dele,
            "binary": binary, "mtime": mtime,
            "ver": hashlib.sha1(raw.encode("utf-8", "surrogateescape")).hexdigest()[:12],
        }
        if note:
            e["note"] = note
        if hint:
            e["hint"] = hint
        if pure:
            e["pure"] = True
        return e

    def watch(self):
        while not self.stopping:
            t0 = time.monotonic()
            try:
                self.scan()
                self._last_error = None
            except Exception as exc:  # keep watching; report each distinct error once
                msg = str(exc)
                if msg != self._last_error and not self.stopping:
                    print("gitdash: %s" % msg, file=sys.stderr, flush=True)
                    self._last_error = msg
            elapsed = time.monotonic() - t0
            time.sleep(min(MAX_POLL_SECONDS, max(POLL_SECONDS, elapsed * 2)))

    def diff(self, path):
        """Return (bytes, truncated, error) for one file in the current snapshot, or None."""
        with self.cond:
            info = self.meta.get(path)
            base = self.base
        if info is None:
            return None
        mode, frm = info
        if mode == "note":
            return b"", False, None
        if mode == "pair":
            text = "diff --git a/%s b/%s\nsimilarity index 100%%\nrename from %s\nrename to %s\n" % (frm, path, frm, path)
            return text.encode("utf-8", "surrogateescape"), False, None
        if mode == "untracked":
            full = os.path.join(self.root, path)
            if os.path.islink(full):
                try:
                    target = os.fsencode(os.readlink(full))
                except OSError as exc:
                    return b"", False, str(exc)
                p = os.fsencode(path)
                return (b"diff --git a/%s b/%s\nnew file mode 120000\n--- /dev/null\n+++ b/%s\n"
                        b"@@ -0,0 +1 @@\n+%s\n\\ No newline at end of file\n" % (p, p, p, target)), False, None
            args = ["diff", "--no-index", "--no-color", "--no-ext-diff", "--", "/dev/null", path]
        else:
            args = ["diff"] + (["--cached"] if mode == "cached" else []) + [
                base, "-M", "--no-color", "--no-ext-diff", "--", path] + ([frm] if frm else [])
        with self.index_lock:
            return self._run_diff(args)

    def _run_diff(self, args):
        with tempfile.TemporaryFile() as errf:
            proc = subprocess.Popen(
                GIT_BASE + args, cwd=self.root, env=self.env,
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=errf,
            )
            try:
                data = proc.stdout.read(DIFF_CAP_BYTES + 1)
                truncated = len(data) > DIFF_CAP_BYTES
                if truncated:
                    cut = data.rfind(b"\n", 0, DIFF_CAP_BYTES)
                    data = data[: cut + 1 if cut > 0 else DIFF_CAP_BYTES]
                    proc.kill()
            finally:
                proc.stdout.close()
                try:
                    proc.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
            err = None
            if not truncated and not data and proc.returncode not in (0, 1):
                errf.seek(0)
                err = errf.read(4000).decode("utf-8", "replace").strip() or "git diff failed"
        return data, truncated, err


class Handler(BaseHTTPRequestHandler):
    server_version = "gitdash"
    repo = None
    page = b""
    allowed_hosts = ()

    def log_message(self, *args):
        pass

    def _send(self, code, body, ctype, extra=None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.headers.get("Host", "") not in self.allowed_hosts:
            return self._send(403, b"forbidden\n", "text/plain")
        url = urlsplit(self.path)
        try:
            if url.path == "/":
                return self._send(200, self.page, "text/html; charset=utf-8")
            if url.path == "/events":
                return self._events()
            if url.path == "/api/diff":
                path = parse_qs(url.query).get("path", [None])[0]
                res = self.repo.diff(path) if path else None
                if res is None:
                    return self._send(404, b"not in the current change set\n", "text/plain")
                data, truncated, err = res
                if err:
                    return self._send(500, (err + "\n").encode("utf-8", "replace"), "text/plain; charset=utf-8")
                return self._send(200, data, "text/plain; charset=utf-8",
                                  {"X-Gitdash-Truncated": "1" if truncated else "0"})
            return self._send(404, b"not found\n", "text/plain")
        except (BrokenPipeError, ConnectionResetError):
            pass

    def _events(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()
        repo, seen = self.repo, -1
        try:
            self.wfile.write(b"retry: 1500\n\n")
            while not repo.stopping:
                with repo.cond:
                    if repo.version == seen:
                        repo.cond.wait(timeout=HEARTBEAT_SECONDS)
                    version, payload = repo.version, repo.payload
                if repo.stopping:
                    break
                if version != seen:
                    self.wfile.write(b"data: " + payload + b"\n\n")
                    seen = version
                else:
                    self.wfile.write(b": heartbeat\n\n")
                self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError, OSError):
            pass


class Server(ThreadingHTTPServer):
    daemon_threads = True
    # kept so a quick restart on the same port works while old sockets sit in TIME_WAIT;
    # explicit ports are probed first (port_in_use), since on macOS this flag also lets
    # a bind to 127.0.0.1 succeed over another server's wildcard listener
    allow_reuse_address = True
    request_queue_size = 128


def port_in_use(port):
    for fam, host in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET6, "::1")):
        try:
            s = socket.socket(fam, socket.SOCK_STREAM)
        except OSError:
            continue  # no IPv6 here
        s.settimeout(0.5)
        try:
            s.connect((host, port))
            return True
        except OSError:
            pass
        finally:
            s.close()
    return False


def port_arg(text):
    try:
        n = int(text)
    except ValueError:
        raise argparse.ArgumentTypeError("not a number: %r" % text)
    if not 0 <= n <= 65535:
        raise argparse.ArgumentTypeError("must be between 0 and 65535")
    return n


def main():
    def stop(*_):
        raise KeyboardInterrupt

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    ap = argparse.ArgumentParser(
        prog="gitdash",
        description="Live browser dashboard of the current git repo's uncommitted changes.",
    )
    ap.add_argument("--port", type=port_arg, default=0, help="port to listen on (default: a free port)")
    ap.add_argument("--no-open", action="store_true", help="do not open the browser")
    ap.add_argument("--version", action="version", version="gitdash " + VERSION)
    args = ap.parse_args()

    repo, srv, tmpdir, serving = None, None, None, False
    try:
        try:
            out, rc = git(["rev-parse", "--show-toplevel"], os.getcwd(), ok=(0, 128, 129))
        except FileNotFoundError:
            print("gitdash: git is not installed or not on PATH", file=sys.stderr)
            return 1
        except GitError as exc:
            print("gitdash: %s" % exc, file=sys.stderr)
            return 1
        root = os.fsdecode(out).strip()
        if rc != 0 or not root:
            print("gitdash: not inside a git work tree (run it from a git repository)", file=sys.stderr)
            return 1
        resolve_git_binary()

        tmpdir = tempfile.mkdtemp(prefix="gitdash-")
        try:
            repo = Repo(root, tmpdir)
            repo.scan()
        except (GitError, OSError) as exc:
            print("gitdash: %s" % exc, file=sys.stderr)
            return 1

        if args.port and port_in_use(args.port):
            print("gitdash: cannot listen on 127.0.0.1:%d (Address already in use)" % args.port, file=sys.stderr)
            return 1
        try:
            srv = Server(("127.0.0.1", args.port), Handler)
        except OSError as exc:
            print("gitdash: cannot listen on 127.0.0.1:%d (%s)" % (args.port, exc.strerror or exc), file=sys.stderr)
            return 1
        port = srv.server_address[1]
        Handler.repo = repo
        Handler.page = PAGE.replace("__REPO__", html.escape(repo.name)).encode("utf-8")
        Handler.allowed_hosts = ("127.0.0.1:%d" % port, "localhost:%d" % port)

        threading.Thread(target=repo.watch, name="watch", daemon=True).start()
        url = "http://127.0.0.1:%d/" % port
        print("gitdash: watching %s\n  %s\n  Ctrl-C to stop" % (root, url), flush=True)
        if not args.no_open:
            t = threading.Timer(0.3, webbrowser.open, (url,))
            t.daemon = True
            t.start()
        serving = True
        srv.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        if not serving:
            return 130
    finally:
        if repo is not None:
            repo.stopping = True
            with repo.cond:
                repo.cond.notify_all()
        if srv is not None:
            srv.server_close()
        if tmpdir is not None:
            shutil.rmtree(tmpdir, ignore_errors=True)
    print("\ngitdash: stopped", flush=True)
    return 0


